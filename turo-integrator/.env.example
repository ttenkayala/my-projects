# Middleware port
PORT=3001

# Jenkins
JENKINS_URL=https://jenkins.your-company.com
JENKINS_USER=your_username
JENKINS_API_TOKEN=your_api_token

# Airflow 3 (Astronomer) — use an API token from cloud.astronomer.io → User Settings → API Tokens
AIRFLOW_URL=https://your-deployment.astronomer.run/your-workspace
AIRFLOW_TOKEN=your_astronomer_api_token

# Optional: cross-system links "jenkins_job:airflow_dag_id" (comma-separated)
# Example: build-pipeline:etl_main_dag,deploy-job:reporting_dag
CROSS_LINKS=
